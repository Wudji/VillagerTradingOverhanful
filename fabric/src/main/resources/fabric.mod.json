{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "https://modrinth.com/project/villager-trading-overhaul/",
    "issues": "https://issue.mengcai.online/",
    "sources": "https://github.com/Wudji/VillagerTradingOverhanful"
  },
  "license": "${license}",
  "icon": "assets/${mod_id}/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.wudji.villagertradingoverhanful.fabric.VillagertradingoverhanfulFabric"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "forgeconfigapiport": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}"
  }
}
